{
  "name": "open-teleprompter",
  "version": "1.0.0",
  "description": "Open Teleprompter - A web-based teleprompter application with controller and display separation",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "start-electron": "electron .",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "teleprompter",
    "presentation",
    "websocket",
    "controller",
    "display",
    "streaming",
    "broadcast",
    "video-production",
    "live-streaming",
    "eyevinn"
  ],
  "author": "Eyevinn Technology AB",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Eyevinn/open-teleprompter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eyevinn/open-teleprompter.git"
  },
  "bugs": {
    "url": "https://github.com/Eyevinn/open-teleprompter/issues"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.eyevinn.openteleprompter",
    "productName": "Open Teleprompter",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "teleprompter icon.png"
    }
  }
}
